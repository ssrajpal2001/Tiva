# =============================================================================
# TiVa — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------

# Port the Express API server listens on
PORT=8080

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/tiva

# Node environment (development | production)
NODE_ENV=production

# ---------------------------------------------------------------------------
# OpenAI (required for AI tutoring and voice transcription)
# Get your key at: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------

AI_INTEGRATIONS_OPENAI_API_KEY=sk-...your-openai-api-key-here...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Frontend (Expo / React Native Web)
# EXPO_PUBLIC_* variables are baked in at build/start time
# ---------------------------------------------------------------------------

# Full URL of your API server — include protocol and port
# For EC2 without SSL:  http://<your-elastic-ip>:8080
# For EC2 with SSL:     https://<your-domain>
EXPO_PUBLIC_API_URL=http://YOUR_ELASTIC_IP:8080

# ---------------------------------------------------------------------------
# ElevenLabs — Voice Cloning (future feature, not required for initial run)
# Get your key at: https://elevenlabs.io
# ---------------------------------------------------------------------------

# ELEVENLABS_API_KEY=your-elevenlabs-key-here
